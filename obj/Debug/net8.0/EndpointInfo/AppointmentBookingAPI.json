        "required": [
          "appointmentDate",
          "reason"
        ],
        "type": "object",
        "properties": {
          "appointmentDate": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginDTO": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Prescription": {
        "required": [
          "dosage",
          "medicines"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "consultationId": {
            "type": "integer",
            "format": "int32"
          },
          "consultation": {
            "$ref": "#/components/schemas/Consultation"
          },
